{
  "name": "mcp-apps-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/main.ts\" \"vite --config web/vite.config.ts\"",
    "dev:server": "tsx watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "pnpm build:web && pnpm build:host",
    "build:web": "vite build --config web/vite.config.ts",
    "build:host": "esbuild host/main.ts --bundle --format=esm --outfile=public/host.js --platform=browser --sourcemap",
    "start": "pnpm build && tsx src/main.ts",
    "verify": "pnpm build:host && tsx scripts/verify.ts",
    "verify:chat": "pnpm build:web && tsx scripts/verify-chat.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "echarts": "^6.1.0",
    "idb-keyval": "^6.3.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.50.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
